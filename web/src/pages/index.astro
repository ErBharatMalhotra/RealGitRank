---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RealGitRank — Engineering Impact Leaderboard</title>
    <meta name="description" content="RealGitRank ranks GitHub developers by one absolute number: public pushes, merged pull requests, closed issues, PR reviews, issue comments and releases over the last 12 months. No percentiles, no weights." />
    <link rel="canonical" href="https://realgitrank.bharatdn.com/" />
    <meta property="og:title" content="RealGitRank — Engineering Impact Leaderboard" />
    <meta property="og:description" content="Commit count measures typing speed. RealGitRank measures engineering impact." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://realgitrank.bharatdn.com/" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    {import.meta.env.PUBLIC_GOATCOUNTER_CODE && (
      <script is:inline async src="https://gc.zgo.at/count.js" data-goatcounter={`https://${import.meta.env.PUBLIC_GOATCOUNTER_CODE}.goatcounter.com/count`}></script>
    )}
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"WebSite","name":"RealGitRank","url":"https://realgitrank.bharatdn.com/","description":"Anti-bot GitHub developer ranking engine"}
    </script>
    <!-- Global: the table rows and the modal are built by the inline script, so
         scoped Astro CSS would never match them. -->
    <style is:global>
      :root { --bg: #0b0f19; --panel: #131a2b; --ink: #e8ecf4; --muted: #8a93a6; --accent: #f59e0b; --accent-2: #14b8a6; --line: #1f2740; }
      body { font-family: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif; max-width: 1180px; margin: 0 auto; padding: 28px 20px; background: var(--bg); color: var(--ink); line-height: 1.5; }
      h1 { font-size: 2.6rem; margin: 0 0 4px; letter-spacing: -0.02em; color: var(--ink); }
      h1 span { color: var(--accent); }
      .sub { color: var(--muted); margin-bottom: 24px; font-size: 15px; }
      .controls { display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; align-items: center; }
      input, select { padding: 10px 12px; border-radius: 6px; border: 1px solid var(--line); background: var(--panel); color: var(--ink); font-size: 14px; font-family: inherit; }
      input { flex: 1; min-width: 200px; }
      .qwrap { position: relative; flex: 1; min-width: 200px; display: flex; }
      .qwrap input { width: 100%; }
      .qres { position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 40; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; max-height: 340px; overflow: auto; box-shadow: 0 10px 30px rgba(0,0,0,.35); }
      .qres a { display: flex; justify-content: space-between; gap: 10px; padding: 7px 12px; font-size: 13px; color: var(--ink); text-decoration: none; }
      .qres a:hover { background: var(--bg); text-decoration: none; }
      .qres .rk { color: var(--muted); font-variant-numeric: tabular-nums; }
      .qres .state { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; }
      .qres a.probe { justify-content: flex-start; color: var(--accent); }
      .qnote { color: var(--muted); font-size: 12px; margin: -6px 0 14px; }
      .qnote code { font-size: 12px; color: var(--ink); }
      input:focus, select:focus { border-color: var(--accent); outline: none; }
      table { width: 100%; border-collapse: collapse; font-size: 14px; }
      th, td { padding: 10px; text-align: left; border-bottom: 1px solid var(--line); }
      th { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; }
      tr:hover { background: var(--panel); }
      a { color: var(--accent); text-decoration: none; font-weight: 500; }
      a:hover { text-decoration: underline; }
      .score { font-weight: 700; color: var(--accent-2); font-variant-numeric: tabular-nums; }
      .verified { color: var(--accent); }
      .bot { color: #f87171; font-size: 11px; }
      .badge { height: 22px; vertical-align: middle; border-radius: 4px; }
      .avatar { width: 24px; height: 24px; border-radius: 50%; vertical-align: middle; margin-right: 6px; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
      .loadmore { display: block; margin: 20px auto; padding: 12px 24px; border-radius: 6px; border: 1px solid var(--accent); background: transparent; color: var(--accent); cursor: pointer; font-family: inherit; font-size: 14px; font-weight: 600; }
      .loadmore:hover { background: var(--accent); color: var(--bg); }
      .stats { color: var(--muted); font-size: 13px; margin-bottom: 12px; }
      .tier { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; padding: 2px 8px; border-radius: 999px; border: 1px solid currentColor; white-space: nowrap; }
      .t-elite { color: #f0abfc; } .t-diamond { color: #60a5fa; } .t-platinum { color: #a78bfa; }
      .t-gold { color: #fbbf24; } .t-silver { color: #cbd5e1; } .t-bronze { color: #d97706; }
      .move { font-size: 11px; margin-left: 6px; font-variant-numeric: tabular-nums; }
      .move.up { color: #34d399; } .move.down { color: #f87171; }
      .details { background: none; border: 1px solid var(--line); color: var(--muted); border-radius: 999px; padding: 1px 8px; font: inherit; font-size: 11px; cursor: pointer; margin-left: 4px; }
      .details:hover { border-color: var(--accent); color: var(--accent); }
      .modal { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 16px; }
      .modal[hidden] { display: none; }
      .modal-backdrop { position: absolute; inset: 0; background: rgba(3, 6, 14, 0.78); }
      .modal-card { position: relative; width: min(640px, 100%); max-height: 85vh; overflow: auto; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 22px; box-shadow: 0 24px 70px rgba(0, 0, 0, 0.55); }
      .modal-x { position: absolute; top: 10px; right: 10px; background: none; border: 0; color: var(--muted); font-size: 26px; line-height: 1; cursor: pointer; padding: 4px 8px; }
      .modal-x:hover { color: var(--ink); }
      .modal h2 { margin: 0 0 2px; font-size: 1.4rem; }
      .modal .muted { color: var(--muted); font-size: 13px; }
      .modal .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 10px; margin: 14px 0; }
      .modal .metric { background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 10px; }
      .modal .metric b { display: block; font-size: 18px; color: var(--accent-2); }
      .modal .metric span { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; }
      .modal .bar { height: 6px; border-radius: 999px; background: var(--bg); overflow: hidden; margin-top: 4px; }
      .modal .bar div { height: 100%; background: var(--accent-2); }
      .modal .links { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 16px; }
      .foot { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; }
      .foot p { margin: 6px 0; }
      @media (max-width: 640px) { table { font-size: 12px; } th, td { padding: 7px 5px; } .modal-card { padding: 16px; } }

      /* ---- appearance refresh ---- */
      :root {
        --bg: #070a12; --panel: #0f1626; --ink: #eef2fa; --muted: #98a3ba;
        --accent: #fbbf24; --accent-2: #2dd4bf; --line: #1d263a;
        --up: #22c55e; --down: #f43f5e;
      }
      body {
        max-width: 1240px; padding: 40px 22px 64px;
        background:
          radial-gradient(900px 480px at 12% -8%, rgba(56, 189, 248, 0.16), transparent 65%),
          radial-gradient(760px 420px at 92% 0%, rgba(244, 114, 182, 0.12), transparent 60%),
          var(--bg);
      }
      h1 {
        font-size: clamp(2.4rem, 5vw, 3.4rem); letter-spacing: -0.03em;
        background: linear-gradient(92deg, #ffffff 8%, #bcc9e6 55%, var(--accent) 100%);
        -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
      }
      .sub { max-width: 940px; color: #b3bed4; font-size: 14.5px; }
      .sub strong { color: #fff; }
      .controls {
        gap: 12px; padding: 14px; border: 1px solid var(--line); border-radius: 16px;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0));
      }
      input, select { border-radius: 10px; background: #0b1220; padding: 11px 13px; }
      input:focus, select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.16); }
      .qres { border-radius: 12px; background: #0d1526; border-color: var(--line); }
      .qnote { color: #8b96ad; }
      .stats { font-size: 12.5px; }
      table {
        border-collapse: separate; border-spacing: 0; font-size: 13.5px;
        background: linear-gradient(180deg, rgba(20, 29, 49, 0.92), rgba(11, 17, 30, 0.92));
        border: 1px solid var(--line); border-radius: 16px; overflow: hidden;
      }
      thead th {
        position: sticky; top: 0; z-index: 2; background: #0d1526; padding: 12px;
        font-size: 10.5px; letter-spacing: 0.09em; border-bottom: 1px solid var(--line);
      }
      tbody td { padding: 11px 12px; border-bottom: 1px solid rgba(29, 38, 58, 0.7); }
      tbody tr:nth-child(even) { background: rgba(255, 255, 255, 0.015); }
      tbody tr:hover { background: rgba(45, 212, 191, 0.07); }
      tbody tr:last-child td { border-bottom: 0; }
      /* GitHub-reported context exists for enriched accounts only. When the loaded
         pages carry none of it, the column is hidden instead of rendering empty. */
      #tbl.no-commits th:nth-child(4), #tbl.no-commits td:nth-child(4),
      #tbl.no-contribs th:nth-child(5), #tbl.no-contribs td:nth-child(5) { display: none; }
      /* Narrow screens: keep every column reachable by scrolling the table
         instead of letting the row run off the page. */
      .tablewrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
      .tablewrap #tbl { min-width: 720px; }
      .tablewrap::-webkit-scrollbar { height: 8px; }
      .tablewrap::-webkit-scrollbar-thumb { background: #263149; border-radius: 999px; }
      .score { color: var(--accent-2); font-weight: 700; font-variant-numeric: tabular-nums; }
      /* Green for climbing, red for dropping. */
      .move {
        display: inline-block; font-size: 11px; font-weight: 800; margin-left: 8px;
        padding: 1px 7px; border-radius: 999px; font-variant-numeric: tabular-nums;
      }
      .move.up { color: #22f08c; background: rgba(34, 197, 94, 0.16); }
      .move.down { color: #ff5d73; background: rgba(244, 63, 94, 0.16); }
      .loadmore { border-radius: 12px; padding: 13px 30px; }
      .foot { color: #8590a7; border-top-color: var(--line); }
      @media (max-width: 900px) {
        body { padding: 24px 14px 44px; }
        table { font-size: 12px; }
        th:nth-child(8), td:nth-child(8), th:nth-child(9), td:nth-child(9) { display: none; }
      }
      /* Phone: identity + score + the two GitHub context columns; everything
         else stays reachable by scrolling the table. */
      @media (max-width: 640px) {
        .tablewrap #tbl { min-width: 0; }
        th:nth-child(6), td:nth-child(6), th:nth-child(7), td:nth-child(7) { display: none; }
      }
    </style>
  </head>
  <body>
    <h1>Real<span>Git</span>Rank</h1>
    <p class="sub"><strong><span id="total">…</span> developers ranked</strong> by public GitHub activity in the last 12 months: pushes + merged pull requests + closed issues + PR reviews + comments + releases. No percentiles, no weights, no tiers — the components are published with every row. <a href="/countries">🌍 Countries & Worldwide →</a> · <a href="/badges/">🏅 README badges →</a> · <a href="/methodology/">📐 Methodology, coverage & API →</a></p>
    <div class="controls">
      <div class="qwrap">
        <input id="q" type="text" placeholder="Search username, country, language..." autocomplete="off" />
        <div class="qres" id="qres" hidden></div>
      </div>
      <select id="country"><option value="">All countries</option></select>
      <select id="lang"><option value="">All languages</option></select>
    </div>
    <p class="qnote">Typing the start of a username searches the whole board; a match inside the name covers the top 50,000. Press <code>Enter</code> to open any username directly, or use <code>/profile/?u=username</code>.</p>
    <div class="stats" id="stats">Loading...</div>
    <div class="tablewrap">
    <table id="tbl">
      <thead><tr><th>#</th><th>User</th><th>Activity (12 mo)</th><th title="GitHub-reported commits, not scored (top 10,000 only)">Commits (1y)</th><th title="GitHub's own contribution count, not scored (top 10,000 only)">Contributions (1y)</th><th>Pushes</th><th>Merged PRs</th><th>Country</th><th>Lang</th></tr></thead>
      <tbody id="tbody"></tbody>
    </table>
    </div>
    <button class="loadmore" id="loadmore">Load more</button>
    <div class="modal" id="modal" hidden>
      <div class="modal-backdrop" data-close></div>
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modal-name">
        <button type="button" class="modal-x" id="modal-close" aria-label="Close details">×</button>
        <div id="modal-body"></div>
      </div>
    </div>
    <footer class="foot">
      <p><strong>Disclaimer:</strong> RealGitRank is an independent, unofficial project built only from public GitHub events. A score is an automated count over one rolling 12-month window — not a statement of fact about a person, not a measure of skill, and not affiliated with GitHub.</p>
      <p>Wrong entry, misattribution, or prefer not to appear? <a href="https://github.com/ErBharatMalhotra/RealGitRank/issues/new?title=Correction%20or%20opt-out%20request&body=GitHub%20username%3A%20%0AWhat%20should%20change%3A%20" target="_blank" rel="noopener noreferrer">Request a correction or removal</a> — applied on the next daily publish.</p>
    </footer>
    <script>
      let allData = [];
      let currentPage = 1;
      let totalPages = 1;
      const tbody = document.getElementById('tbody');
      const q = document.getElementById('q');
      const countrySel = document.getElementById('country');
      const langSel = document.getElementById('lang');
      const stats = document.getElementById('stats');
      const loadmore = document.getElementById('loadmore');
      const qres = document.getElementById('qres');
      let nameIndex = null;
      const bucketCache = new Map();
      let searchSeq = 0;

      // The table only holds the pages loaded so far, so a name in the rest of the
      // board (or beyond the first page) would never match there. The pipeline
      // publishes one rank-ordered name list for the detailed board; fetch it on
      // the first search and look across all of it.
      function loadNameIndex() {
        if (!nameIndex) {
          nameIndex = fetch('/data/search/names.json')
            .then((r) => (r.ok ? r.json() : []))
            .catch(() => []);
        }
        return nameIndex;
      }

      // The prefix buckets hold every listed developer ([username, rank, score] per
      // first character, ~0.3-1 MB gzipped each), so a prefix lookup reaches the
      // long tail without shipping the whole board. names.json supplies the
      // "contains" matches for the detailed top 50k.
      function bucketKey(name) {
        const c = String(name || '').slice(0, 1).toLowerCase();
        return /[a-z0-9]/.test(c) ? c : 'other';
      }

      function loadBucket(key) {
        if (!bucketCache.has(key)) {
          bucketCache.set(key, fetch(`/data/search/${key}.json`)
            .then((r) => (r.ok ? r.json() : []))
            .catch(() => []));
        }
        return bucketCache.get(key);
      }

      function renderRemote(v) {
        const seq = ++searchSeq;
        if (!v || v.length < 2) {
          qres.hidden = true;
          qres.innerHTML = '';
          return;
        }
        Promise.all([loadNameIndex(), loadBucket(bucketKey(v))]).then(([names, bucket]) => {
          if (seq !== searchSeq) return;
          const seen = new Set();
          const hits = [];
          const add = (name, rank, state, prefix) => {
            const key = String(name).toLowerCase();
            if (seen.has(key) || hits.length === 30) return;
            seen.add(key);
            hits.push({ name, rank, state: state || (rank ? 'ranked' : 'listed'), prefix });
          };
          // New buckets carry [username, rank, score, state, page]; listed rows
          // have rank null on purpose. Old 3-field rows still work.
          for (const row of bucket) {
            const [name, rank, , state] = row;
            if (String(name).toLowerCase().startsWith(v)) add(name, rank, state, true);
          }
          for (const [name, rank] of names) {
            if (String(name).toLowerCase().includes(v)) add(name, rank, 'ranked', false);
          }
          // Typing the full login should always put that account first.
          hits.sort((a, b) => (b.name.toLowerCase() === v) - (a.name.toLowerCase() === v));
          qres.innerHTML = hits.map((h) => {
            const label = h.state === 'listed' || !h.rank
              ? '<span class="state">listed</span>'
              : `<span class="rk">#${h.rank}</span>`;
            const why = h.prefix ? '' : ' title="Matched inside the name (top 50,000)"';
            return `<a href="/profile/?u=${encodeURIComponent(h.name)}"${why}>`
              + `<span>${esc(h.name)}</span>${label}</a>`;
          }).join('');
          if (!hits.length) {
            qres.innerHTML = `<a class="probe" href="/profile/?u=${encodeURIComponent(v)}">Open profile for “${esc(v)}” →</a>`;
          }
          qres.hidden = false;
        });
      }

      function row(u) {
        const tr = document.createElement('tr');
        tr.dataset.u = (u.username||'').toLowerCase();
        tr.dataset.c = (u.country||'').toLowerCase();
        tr.dataset.l = (u.primary_language||'').toLowerCase();
        const delta = typeof u.rank_delta === 'number' ? u.rank_delta : 0;
        const move = delta === 0 ? '' : `<span class="move ${delta > 0 ? 'up' : 'down'}" title="vs yesterday">${delta > 0 ? '▲' : '▼'}${Math.abs(delta)}</span>`;
        tr.innerHTML = `<td>${u.rank}${move}</td>
          <td><img src="${u.avatar_url||''}" alt="" width="24" height="24" style="border-radius:50%;vertical-align:middle;margin-right:6px" onerror="this.style.display='none'" /><a href="https://github.com/${u.username}" target="_blank" rel="noopener noreferrer">${u.username}</a> <button type="button" class="details" data-u="${u.username}" aria-label="Show details for ${u.username}">details</button></td>
          <td class="score">${num(u.rank_score)}</td>
          <td>${num(u.commits_1y)}</td>
          <td>${num(u.contributions_1y)}</td>
          <td>${num(u.total_pushes)}</td>
          <td>${num(u.merged_prs)}</td>
          <td>${u.country||'—'}</td>
          <td>${u.primary_language||'—'}</td>`;
        return tr;
      }

      function applyFilter() {
        const v = q.value.toLowerCase();
        const c = countrySel.value;
        const l = langSel.value;
        let visible = 0;
        document.querySelectorAll('#tbl tbody tr').forEach(r => {
          const match = (r.dataset.u.includes(v) || r.dataset.c.includes(v) || r.dataset.l.includes(v))
            && (!c || r.dataset.c === c) && (!l || r.dataset.l === l);
          r.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        stats.textContent = `Showing ${visible} of ${allData.length} loaded (${totalPages > 1 ? currentPage + '/' + totalPages + ' pages' : ''})`;
        renderRemote(v);
      }

      q.addEventListener('blur', () => setTimeout(() => { qres.hidden = true; }, 150));
      q.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const v = q.value.trim();
          if (v.length >= 2) { e.preventDefault(); location.href = `/profile/?u=${encodeURIComponent(v)}`; }
        }
        if (e.key === 'Escape') qres.hidden = true;
      });

      async function loadPage(p) {
        const r = await fetch(`/data/chunks/page_${p}.json`);
        const data = await r.json();
        data.forEach(u => { allData.push(u); tbody.appendChild(row(u)); });
        currentPage = p;
        // populate dropdowns on first load
        if (p === 1) {
          const countries = [...new Set(allData.map(u => u.country).filter(Boolean))].sort();
          const langs = [...new Set(allData.map(u => u.primary_language).filter(Boolean))].sort();
          countries.forEach(c => { const o = document.createElement('option'); o.value = c.toLowerCase(); o.textContent = c; countrySel.appendChild(o); });
          langs.forEach(l => { const o = document.createElement('option'); o.value = l.toLowerCase(); o.textContent = l; langSel.appendChild(o); });
          fetch('/data/status.json').then((r) => r.json()).then((s) => {
            document.getElementById('total').textContent = (s.users_ranked ?? s.users ?? 0).toLocaleString();
          }).catch(() => {});
        }
        updateContextColumns();
        applyFilter();
        if (currentPage >= totalPages) loadmore.style.display = 'none';
      }

      // Commits/contributions are GitHub-reported and only enriched accounts have
      // them. Hide a column with no values anywhere in the loaded rows.
      function updateContextColumns() {
        const has = (key) => allData.some((u) => typeof u[key] === 'number' && u[key] > 0);
        const tbl = document.getElementById('tbl');
        tbl.classList.toggle('no-commits', !has('commits_1y'));
        tbl.classList.toggle('no-contribs', !has('contributions_1y'));
      }

      const modal = document.getElementById('modal');
      const modalBody = document.getElementById('modal-body');
      const modalClose = document.getElementById('modal-close');
      let lastFocus = null;
      let detailsSeq = 0;

      const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (ch) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
      const num = (v) => (typeof v === 'number' && Number.isFinite(v) ? v.toLocaleString() : '—');

      function closeDetails() {
        if (modal.hidden) return;
        modal.hidden = true;
        document.body.style.overflow = '';
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }

      function renderDetails(payload) {
        // /api/user/<name>.json wraps the record: { generated_at, window, user: {...} }
        const d = payload && typeof payload.user === 'object' && payload.user ? payload.user : payload;
        const name = String(d.username || '');
        const components = [
          ['Pushes', d.total_pushes],
          ['Merged PRs', d.merged_prs],
          ['Closed issues', d.closed_issues],
          ['PR reviews', d.pr_reviews],
          ['Issue comments', d.issue_comments],
          ['Releases', d.releases],
        ];
        const sum = components.reduce((total, [, value]) => total + (Number(value) || 0), 0) || 1;
        const pillars = components.map(([label, value]) => {
          const v = Number(value) || 0;
          const share = (v / sum) * 100;
          return `<div style="margin:8px 0"><div style="display:flex;justify-content:space-between;font-size:13px"><span>${label}</span><span class="muted">${v.toLocaleString()} (${share.toFixed(1)}%)</span></div><div class="bar"><div style="width:${share}%"></div></div></div>`;
        }).join('');
        const merges = Array.isArray(d.counted_merges) ? d.counted_merges.slice(0, 8).map((m) =>
          `<li><a href="https://github.com/${String(m.repo).split('/').map(encodeURIComponent).join('/')}/pulls?q=is%3Apr+is%3Amerged" target="_blank" rel="noopener noreferrer nofollow">${esc(m.repo)}</a> — ${num(m.prs)} merged PR</li>`
        ).join('') : '';
        // Every ranked user has a profile view; the per-user JSON exists for the top 1,000.
        const profileLink = d.rank
          ? `<a href="/profile/?u=${encodeURIComponent(name)}&r=${encodeURIComponent(String(d.rank))}">Full profile →</a>` : '';
        modalBody.innerHTML = `
          <h2 id="modal-name">${esc(name)}</h2>
          <p class="muted">${d.rank ? 'Rank #' + num(d.rank) : 'Unranked'}${d.country ? ' · ' + esc(d.country) : ''}${d.primary_language ? ' · ' + esc(d.primary_language) : ''}</p>
          <div class="metrics">
            <div class="metric"><b>${num(d.rank_score)}</b><span>Activity (12 mo)</span></div>
            <div class="metric"><b>${num(d.merged_prs)}</b><span>Merged PRs</span></div>
            <div class="metric"><b>${num(d.active_days)}</b><span>Active days</span></div>
            <div class="metric"><b>${num(d.pr_reviews)}</b><span>Reviews</span></div>
            <div class="metric"><b>${num(d.commits_1y)}</b><span>Commits (1y)</span></div>
            <div class="metric"><b>${num(d.contributions_1y)}</b><span>Contributions (1y)</span></div>
          </div>
          <h3 style="margin:14px 0 4px;font-size:14px">What the activity is made of</h3>
          ${pillars}
          <p class="muted" style="margin:8px 0 0">The score is the sum of these six public event counts over the last 12 months. Nothing is percentile-ranked or weighted.</p>
          ${merges ? `<h3 style="margin:16px 0 4px;font-size:14px">Counted merges</h3><ul style="margin:0;padding-left:18px;font-size:13px">${merges}</ul>` : ''}
          <p class="muted" style="margin:14px 0 0">An automated count of public GitHub events over a rolling 12-month window, not a statement of fact about a person.</p>
          <div class="links"><a href="https://github.com/${encodeURIComponent(name)}" target="_blank" rel="noopener noreferrer">GitHub profile ↗</a>${profileLink}<a href="https://github.com/ErBharatMalhotra/RealGitRank/issues/new?title=Correction%20or%20opt-out%20request&body=GitHub%20username%3A%20%0AWhat%20should%20change%3A%20" target="_blank" rel="noopener noreferrer">Report / opt out</a></div>`;
      }

      // Per-user JSON exists only for the top 1,000; everyone else is rendered
      // from the chunk row already loaded in the table.
      function loadedRow(name) {
        const want = String(name).toLowerCase();
        return allData.find((u) => (u.username || '').toLowerCase() === want) || null;
      }

      async function openDetails(name) {
        lastFocus = document.activeElement;
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        modalBody.innerHTML = '<p class="muted">Loading details…</p>';
        modalClose.focus();
        const seq = ++detailsSeq;
        try {
          const res = await fetch(`/api/user/${encodeURIComponent(name)}.json`, { headers: { accept: 'application/json' } });
          if (!res.ok) throw new Error(res.status === 404 ? 'No details found for this user.' : 'Could not load details.');
          const data = await res.json();
          if (seq === detailsSeq) renderDetails(data);
        } catch (err) {
          const row = loadedRow(name);
          if (seq !== detailsSeq) return;
          if (row) renderDetails(row);
          else modalBody.innerHTML = `<p class="muted">${esc(err.message || 'Could not load details.')} <a href="https://github.com/${encodeURIComponent(name)}" target="_blank" rel="noopener noreferrer">Open GitHub →</a></p>`;
        }
      }

      tbody.addEventListener('click', (e) => {
        const btn = e.target.closest('button.details');
        if (btn) { e.preventDefault(); openDetails(btn.dataset.u); }
      });
      modal.addEventListener('click', (e) => { if (e.target.closest('[data-close]')) closeDetails(); });
      modalClose.addEventListener('click', closeDetails);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDetails(); });

      loadmore.addEventListener('click', () => { if (currentPage < totalPages) loadPage(currentPage + 1); });
      q.addEventListener('input', applyFilter);
      countrySel.addEventListener('change', applyFilter);
      langSel.addEventListener('change', applyFilter);

      fetch('/data/chunks/index.json').then(r => r.json()).then(idx => {
        totalPages = idx.pages;
        loadPage(1);
      });
    </script>
  </body>
</html>