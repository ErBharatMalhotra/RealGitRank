---
import fs from 'node:fs';
import path from 'node:path';
const SITE = 'https://realgitrank.bharatdn.com';
const CORRECTION_URL = 'https://github.com/ErBharatMalhotra/RealGitRank/issues/new?title=Correction%20or%20opt-out%20request&body=GitHub%20username%3A%20%0AWhat%20should%20change%3A%20';
let coverage = null;
let validation = null;
try {
  coverage = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), 'public', 'data', 'coverage.json'), 'utf-8'));
} catch (e) { coverage = null; }
try {
  validation = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), 'public', 'data', 'validation.json'), 'utf-8'));
} catch (e) { validation = null; }
const pillarCoverage = coverage
  ? Object.entries(coverage.pillars).map(([key, value]) => ({ key, ...value }))
  : [];
const tiers = [
  ['Elite', '99th percentile and above', '#f0abfc'],
  ['Diamond', '95th percentile', '#60a5fa'],
  ['Platinum', '90th percentile', '#a78bfa'],
  ['Gold', '75th percentile', '#fbbf24'],
  ['Silver', '50th percentile', '#cbd5e1'],
  ['Bronze', 'everyone else', '#d97706'],
];
const pillars = [
  ['Delivery', '35%', 'Pull requests the developer merged in the rolling 30-day window (merge events, not authored count). Merging someone else’s PR in their repo weighs 1.5×; a self-merge in an owned repo weighs 1.0×.', 'Only completed merges count, so opening PRs does not move the score.'],
  ['Code health', '25%', 'Share of observed commits and merged PRs whose text mentions tests, plus the multi-file PR ratio.', 'Counted only when the events feed actually carries the signal — otherwise the pillar is excluded, not scored as zero.'],
  ['Adoption', '25%', 'Stars and forks received by the developer’s repositories in the window.', 'Same-window events only; downstream dependents are not observed yet and are not claimed.'],
  ['Consistency', '15%', 'Distinct ISO weeks with shipping activity and the spread of push hours across the window.', 'Round-the-clock activity lowers the human-likeness signal instead of raising the score.'],
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Methodology &amp; API — RealGitRank</title>
    <meta name="description" content="How the RealGitRank engineering impact score is computed: delivery, code health, adoption and consistency pillars, the automation adjustment, tiers, daily snapshots and the static JSON API." />
    <link rel="canonical" href={`${SITE}/methodology/`} />
    {import.meta.env.PUBLIC_GOATCOUNTER_CODE && (
      <script is:inline async src="https://gc.zgo.at/count.js" data-goatcounter={`https://${import.meta.env.PUBLIC_GOATCOUNTER_CODE}.goatcounter.com/count`}></script>
    )}
    <meta property="og:title" content="Methodology &amp; API — RealGitRank" />
    <meta property="og:description" content="The four pillars behind the RealGitRank score, the automation adjustment, tier bands, and the static JSON endpoints." />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={`${SITE}/methodology/`} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: 'RealGitRank methodology and API',
      url: `${SITE}/methodology/`,
      about: 'Engineering impact scoring for GitHub developers',
    })} />
    <style>
      :root { --bg: #0b0f19; --panel: #131a2b; --ink: #e8ecf4; --muted: #8a93a6; --accent: #f59e0b; --accent-2: #14b8a6; --line: #1f2740; }
      body { font-family: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif; max-width: 900px; margin: 0 auto; padding: 28px 20px 64px; background: var(--bg); color: var(--ink); line-height: 1.6; }
      h1 { font-size: 2.3rem; margin: 0 0 4px; letter-spacing: -0.02em; }
      h1 span { color: var(--accent); }
      h2 { font-size: 1.15rem; margin: 32px 0 10px; }
      h3 { font-size: 1rem; margin: 20px 0 6px; }
      p, li { color: var(--ink); }
      .sub { color: var(--muted); margin: 0 0 24px; }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 18px 20px; margin: 16px 0; }
      .formula { font-size: 1.02rem; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; overflow-x: auto; font-variant-numeric: tabular-nums; }
      .formula strong { color: var(--accent-2); }
      table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 10px 0 4px; }
      th, td { text-align: left; padding: 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
      th { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; }
      code, pre { font-family: ui-monospace, "Cascadia Code", Consolas, monospace; font-size: 12.5px; }
      code { background: var(--bg); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; }
      pre { background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; overflow-x: auto; }
      ul { padding-left: 20px; }
      li { margin: 5px 0; }
      .tier { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; padding: 2px 8px; border-radius: 999px; border: 1px solid currentColor; white-space: nowrap; }
      .note { color: var(--muted); font-size: 13px; }
      .endpoint { font-family: ui-monospace, Consolas, monospace; font-size: 13px; color: var(--accent-2); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    </style>
  </head>
  <body>
    <a href="/">← Leaderboard</a>
    <h1>Methodology &amp; <span>API</span></h1>
    <p class="sub">How RealGitRank turns public GitHub events into an engineering impact index — and where to read the data yourself.</p>

    <h2>The score</h2>
    <div class="formula">
      Rank Score = 10 × Σ(weight × pillar percentile) ÷ Σ(weights observed) × (1 − automation adjustment)
    </div>
    <p>Every pillar is computed from real GitHub public events over a <strong>rolling 30-day window</strong>, then percentile-ranked inside the cohort where that pillar is actually observed and mapped to 0–100. The weighted average is scaled to 0–1000; when a pillar is unknown for a user, its weight is redistributed over the observed pillars rather than counted as zero. Commit count is never a pillar. No score is blended with an older scale, and there is no decay: a developer with no activity in the window is not ranked.</p>

    <h2>The four pillars</h2>
    <table>
      <thead><tr><th>Pillar</th><th>Weight</th><th>What it measures</th><th>Why it is hard to game</th></tr></thead>
      <tbody>
        {pillars.map(([name, weight, what, why]) => (
          <tr>
            <td><strong>{name}</strong></td>
            <td style="color:var(--accent)">{weight}</td>
            <td>{what}</td>
            <td>{why}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note">Pillar sub-scores (<code>s_pr</code>, <code>s_quality</code>, <code>s_impact</code>, <code>s_consistency</code>) are 0–100 percentiles. <code>s_quality</code> is omitted when no test/file evidence exists, and each record’s <code>measured</code> object states which pillars counted. Percentile is against the whole ranked population.</p>

    <h2>What is actually measured</h2>
    {coverage ? (
      <>
        <p class="note">Computed from the published snapshot: {(coverage.users_total || coverage.users).toLocaleString()} ranked developers (the table below describes the {coverage.users.toLocaleString()} newest rows with full metrics), window {coverage.window_start} → {coverage.window_end} ({coverage.window_days} days), score version <code>{coverage.score_version}</code>.</p>
        <table>
          <thead><tr><th>Signal</th><th>Observed</th><th>Coverage</th></tr></thead>
          <tbody>
            {pillarCoverage.map((p) => (
              <tr><td>{p.label}</td><td>{p.measured.toLocaleString()}</td><td>{p.pct}%</td></tr>
            ))}
            <tr><td>Automation-signal evidence (commit messages or changed-file counts)</td><td>{coverage.automation_evidence.measured.toLocaleString()}</td><td>{coverage.automation_evidence.pct}%</td></tr>
            <tr><td>Country known</td><td>{coverage.country.known.toLocaleString()}</td><td>{coverage.country.pct}%</td></tr>
            <tr><td>Primary language known</td><td>{coverage.language.known.toLocaleString()}</td><td>{coverage.language.pct}%</td></tr>
          </tbody>
        </table>
        <p class="note">Country and language come from optional GitHub API enrichment, which is rate-limited; the country/language filters only cover that subset. When the automation signal is missing, no adjustment is guessed and the entry stays neutral.</p>
        {coverage.source ? (
          <>
            <h3>Source coverage</h3>
            <p class="note">The window is built from <a href="https://www.gharchive.org/" target="_blank" rel="noopener noreferrer">gharchive.org</a> hourly event dumps. gharchive is a partial mirror of public GitHub events, so a developer whose activity the mirror did not carry cannot be ranked — that is a source limitation, not a judgement. These numbers state how much of the stream this window actually saw.</p>
            <p class="note">Push payloads are trimmed in the public feed: a push made by the <code>github-actions</code> bot carries the repository and the head commit, but not the commit author. Rather than guess, those pushes are counted as a separate <strong>CI-attributed</strong> signal for the owner of a user-owned repository (organisation repos are skipped). CI pushes never enter the commit-message entropy denominator, add no active hours and no repositories, so an automated workflow cannot look like human round-the-clock work; they make an otherwise invisible owner rankable, nothing more.</p>
            <table>
              <thead><tr><th>Source</th><th>Value</th></tr></thead>
              <tbody>
                <tr><td>Days measured</td><td>{coverage.source.days_measured} of {coverage.source.days_in_window}</td></tr>
                <tr><td>Hourly files ingested</td><td>{coverage.source.hourly_files.toLocaleString()}</td></tr>
                <tr><td>Public events seen</td><td>{coverage.source.events.toLocaleString()}</td></tr>
                <tr><td>Events per day (avg)</td><td>{coverage.source.events_per_day.toLocaleString()}</td></tr>
                <tr><td>Bot events skipped</td><td>{coverage.source.bot_events.toLocaleString()} ({coverage.source.bot_share_pct}%)</td></tr>
                {coverage.source.ci_pushes ? (
                  <tr><td>CI-attributed pushes (github-actions bot, credited to the repository owner)</td><td>{coverage.source.ci_pushes.toLocaleString()}</td></tr>
                ) : null}
              </tbody>
            </table>
          </>
        ) : null}
      </>
    ) : (
      <p class="note">Coverage data is generated by the pipeline; run it to populate this table.</p>
    )}

    <h2>Automation adjustment</h2>
    <p>Only aggregate behaviour from the public push stream is used. A score is reduced when that stream shows machine-like patterns:</p>
    <ul>
      <li><strong>+0.50</strong> — fewer than 10% unique commit messages (<code>update</code>, <code>auto commit #123</code>).</li>
      <li><strong>+0.30</strong> — pushes spread across 23–24 distinct hours of the day, with no sleep window.</li>
      <li><strong>+0.40</strong> — single-line churn: average changed files below 1.05 per commit.</li>
    </ul>
    <p>The adjustment multiplies the final score and applies only to signals that were actually observed; when the events feed does not carry them, it stays neutral and the gap is published in the coverage table above. Per-account classification values are not part of the public layer: the site and the JSON API show a score, never a label about an account. This is a heuristic, not a guarantee, and it is never a statement of intent, identity or misconduct.</p>

    <h2>Tiers</h2>
    <table>
      <thead><tr><th>Tier</th><th>Percentile</th></tr></thead>
      <tbody>
        {tiers.map(([name, band, color]) => (
          <tr>
            <td><span class="tier" style={`color:${color}`}>{name}</span></td>
            <td>{band}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note">A tier is a relative band of the current ranked population, so it moves as the population grows. Tier and percentile are recomputed on every daily run.</p>

    <h2>Rolling window, snapshots and movement</h2>
    <ul>
      <li>Each run ingests one day of GH Archive events into <code>data/rolling/&lt;YYYY-MM-DD&gt;.json.gz</code>; scoring reads the newest 30 shards and prunes older ones.</li>
      <li>Scores therefore describe a month of work, not yesterday's throughput. There is no 70/30 blending with an older scale and no daily decay.</li>
      <li>Each run stores the top 1,000 in <code>data/history/&lt;YYYY-MM-DD&gt;.json</code>; snapshots older than 30 days are pruned. <code>rank_delta</code> / <code>score_delta</code> compare with the previous snapshot and are omitted for new or returning users.</li>
      <li>Profiles in the top 1,000 keep up to 30 daily points for the trend sparkline, plus the repositories behind their merged-PR count.</li>
    </ul>

    <h2>Data sources and freshness</h2>
    <p>A scheduled GitHub Actions workflow (daily, ~02:00 UTC) downloads the previous day of public GH Archive events, folds it into the rolling window, scores every account, runs data-quality gates, then rebuilds and deploys this static site on GitHub Pages. Enrichment (avatar, country, company, language) comes from the GitHub API when a token is configured. Everything is free, static and versioned in git — there is no database and no runtime server.</p>
    <p class="note">Profile pages also show lifetime context reported by the GitHub API (commits in the last year, stars on owned repositories, followers). It is context only — the score never uses it, because the public event feed does not publish every push and a single push can carry hundreds of commits. This is why a developer with thousands of commits can still show few or zero pushes in the window.</p>
    <p class="note">Known limitations: the public events feed does not expose file lists for every merge or languages at all, so code-health and language signals are partial; stars/forks only count events inside the window; the bot heuristic cannot see signals that were never delivered. All of this is measured above instead of being assumed.</p>

    <h2>Independent validation</h2>
    {validation ? (
      <div class="panel">
        <p><strong>{validation.match_rate}% of counted merge events confirmed</strong> by GitHub ({validation.checked_at.slice(0, 10)}): {validation.events_confirmed} of {validation.events_checked} checked events across {validation.users_with_events} developers, {validation.events_unknown} unknown (private/deleted). Each event is fetched from the GitHub PR API and must have <code>merged_at</code> inside {validation.window_start} → {validation.window_end} and <code>merged_by.login</code> equal to the ranked account.</p>
        <p class="note">Weekly spot check of the top 50 plus a deterministic random sample; the full event list is in <a href="/data/validation.json">/data/validation.json</a>. Counts are merge events, so they are not comparable to GitHub's “PRs authored” search totals.</p>
      </div>
    ) : (
      <p class="note">The weekly validation job has not produced a report yet. Until then, treat merge counts as unvalidated.</p>
    )}

    <h2>Static JSON API</h2>
    <p>All endpoints are pre-built files on GitHub Pages, so they are cacheable, CORS-free for normal fetches, and cost nothing to serve.</p>
    <ul>
      <li><a class="endpoint" href="/api/leaderboard.json">/api/leaderboard.json</a> — every ranked developer in one document: <code>generated_at</code>, <code>snapshot_date</code>, <code>count</code>, <code>weights</code>, <code>tier_bands</code>, <code>url_templates</code> and a <code>users</code> array. Records are compact; <code>avatar_url</code> and <code>bio</code> are served only by the per-user endpoint.</li>
      <li><a class="endpoint" href="/api/user/sirine2907.json">/api/user/&lt;username&gt;.json</a> — one developer's record for the top 1,000, including <code>history</code>, <code>company</code>, <code>location</code> and <code>bio</code> when available. Outside the top 1,000 there is no per-user file; read that row from the chunks. Username casing must match the leaderboard.</li>
      <li><a class="endpoint" href="/data/chunks/index.json">/data/chunks/index.json</a> — pagination metadata for <code>/data/chunks/page_N.json</code> (250 rows per page).</li>
      <li><a class="endpoint" href="/data/search.json">/data/search.json</a> — compact <code>[username, rank, score]</code> index for client-side search.</li>
      <li><a class="endpoint" href="/data/coverage.json">/data/coverage.json</a> — measured/null counts for every pillar, bot evidence coverage, and the validation summary shown above.</li>
      <li><a class="endpoint" href="/badges/default.svg">/badges/&lt;username&gt;.svg</a> — README badge; dedicated badges exist for the global top 1,000.</li>
      <li><a class="endpoint" href="/llms.txt">/llms.txt</a> — a short plain-text guide for LLM and agent consumers.</li>
    </ul>

    <h3>Example record</h3>
<pre>&#123;
  "username": "sirine2907",
  "rank": 1,
  "rank_score": 913.4,
  "score_version": "v2-percentile",
  "measured": &#123; "delivery": true, "code_health": true, "adoption": true, "consistency": true &#125;,
  "tier": "Elite",
  "percentile": 100.0,
  "country": "United States",
  "primary_language": "Dart",
  "merged_prs": 17,
  "counted_merges": [ &#123; "repo": "owner/project", "prs": 9 &#125; ],
  "active_days": 21, "window_days": 30,
  "profile_url": "{SITE}/profile/sirine2907",
  "badge_url": "{SITE}/badges/sirine2907.svg",
  "api_url": "{SITE}/api/user/sirine2907.json"
&#125;</pre>
    <p class="note">Field names follow the pipeline schema; optional fields are omitted rather than set to null. Please link back to {SITE.replace('https://', '')} when you publish a rank or score.</p>

    <h2 id="corrections">Corrections, removal and disclaimer</h2>
    <p>RealGitRank is an independent, unofficial project built only from public GitHub events. A score is an automated estimate over one rolling window — not a statement of fact about a person, not a measure of skill or worth, and not affiliated with GitHub or an endorsement of anyone.</p>
    <p>If an entry is wrong, misattributed, or you would rather not appear, open a request with the username and what should change: <a href={CORRECTION_URL} target="_blank" rel="noopener noreferrer">correction or removal request</a>. Removals are applied on the next daily publish, after which the entry disappears from the leaderboard, the JSON API, the public chunks and the badge endpoint.</p>

    <h2>Related</h2>
    <ul>
      <li><a href="/">Global leaderboard</a></li>
      <li><a href="/badges/">README badges</a></li>
      <li><a href="/countries">Country leaderboards</a></li>
      <li><a href={CORRECTION_URL} target="_blank" rel="noopener noreferrer">Correction or removal request</a></li>
    </ul>
  </body>
</html>
