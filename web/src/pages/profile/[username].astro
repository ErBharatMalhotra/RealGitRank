---
import fs from 'node:fs';
import path from 'node:path';
export function getStaticPaths() {
  const dataDir = path.resolve(process.cwd(), '..', 'data', 'profiles');
  const files = fs.readdirSync(dataDir).filter(f => f.endsWith('.json'));
  return files.map(f => {
    const u = f.replace('.json', '');
    const data = JSON.parse(fs.readFileSync(path.join(dataDir, f), 'utf-8'));
    return { params: { username: u }, props: { data } };
  });
}
const { username } = Astro.params;
const { data } = Astro.props;

// Daily score series kept by the pipeline (top 1,000 profiles only).
const history = (Array.isArray(data.history) ? data.history : []).filter((p) => p && typeof p.s === 'number');
let spark = null;
if (history.length > 1) {
  const w = 320, h = 64, pad = 8;
  const min = Math.min(...history.map((p) => p.s));
  const max = Math.max(...history.map((p) => p.s));
  const x = (i) => pad + (i * (w - 2 * pad)) / (history.length - 1);
  const y = (v) => h - pad - (max === min ? 0.5 : ((v - min) / (max - min))) * (h - 2 * pad);
  const line = history.map((p, i) => `${x(i).toFixed(1)},${y(p.s).toFixed(1)}`).join(' ');
  spark = {
    w, h, line,
    area: `${x(0).toFixed(1)},${(h - pad).toFixed(1)} ${line} ${x(history.length - 1).toFixed(1)},${(h - pad).toFixed(1)}`,
    min, max, first: history[0].d, last: history[history.length - 1].d, points: history.length,
  };
}
const activityComponents = [
  ['Pushes', data.total_pushes],
  ['Merged pull requests', data.merged_prs],
  ['Closed issues', data.closed_issues],
  ['PR reviews', data.pr_reviews],
  ['Issue comments', data.issue_comments],
  ['Releases', data.releases],
];
const activityTotal = activityComponents.reduce((sum, [, value]) => sum + (Number(value) || 0), 0) || 1;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{username} — RealGitRank</title>
    <meta name="description" content={`RealGitRank profile for ${username}: score ${data.rank_score}, rank #${data.rank}.`} />
    <link rel="canonical" href={`https://realgitrank.bharatdn.com/profile/${username}`} />
    {import.meta.env.PUBLIC_GOATCOUNTER_CODE && (
      <script is:inline async src="https://gc.zgo.at/count.js" data-goatcounter={`https://${import.meta.env.PUBLIC_GOATCOUNTER_CODE}.goatcounter.com/count`}></script>
    )}
    <meta property="og:title" content={`${username} — RealGitRank`} />
    <meta property="og:description" content={`RealGitRank score ${data.rank_score}, rank #${data.rank}`} />
    <meta property="og:image" content={`https://realgitrank.bharatdn.com/badges/${username}.svg`} />
    <meta property="og:type" content="profile" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Person","name":username,"url":`https://realgitrank.bharatdn.com/profile/${username}`})} />
    <style>
      :root { --bg: #0b0f19; --panel: #131a2b; --ink: #e8ecf4; --muted: #8a93a6; --accent: #f59e0b; --accent-2: #14b8a6; --line: #1f2740; }
      body { font-family: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif; max-width: 760px; margin: 0 auto; padding: 28px 20px; background: var(--bg); color: var(--ink); }
      h1 { font-size: 2.4rem; margin: 0 0 4px; letter-spacing: -0.02em; color: var(--ink); }
      h3 { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; margin: 20px 0 8px; }
      .card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 20px; margin: 16px 0; }
      .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .stat { background: var(--bg); padding: 12px; border-radius: 6px; border: 1px solid var(--line); }
      .label { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; }
      .val { font-size: 22px; font-weight: 700; color: var(--accent-2); font-variant-numeric: tabular-nums; }
      .bar { height: 6px; background: var(--line); border-radius: 3px; overflow: hidden; margin-top: 6px; }
      .bar > div { height: 100%; background: var(--accent); }
      a { color: var(--accent); }
      img.badge { margin: 12px 0; border-radius: 6px; }
      pre { background: var(--bg); padding: 10px; border-radius: 6px; overflow: auto; font-size: 12px; border: 1px solid var(--line); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .tier { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; padding: 2px 10px; border-radius: 999px; border: 1px solid currentColor; vertical-align: middle; margin-right: 6px; }
      .t-elite { color: #f0abfc; } .t-diamond { color: #60a5fa; } .t-platinum { color: #a78bfa; }
      .t-gold { color: #fbbf24; } .t-silver { color: #cbd5e1; } .t-bronze { color: #d97706; }
      .spark { display: block; width: 100%; height: 64px; margin: 8px 0 4px; }
      .sparkmeta { display: flex; justify-content: space-between; gap: 8px; color: var(--muted); font-size: 11px; }
      .delta-up { color: #34d399; } .delta-down { color: #f87171; }
      .movement { margin: 6px 0 0; font-size: 13px; color: var(--muted); }
      @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
      img.badge { margin: 12px 0; }

      /* ---- appearance refresh ---- */
      :root {
        --bg: #070a12; --panel: #101827; --ink: #eef2fa; --muted: #98a3ba;
        --accent: #fbbf24; --accent-2: #2dd4bf; --line: #1d263a;
        --up: #22c55e; --down: #f43f5e;
      }
      body {
        max-width: 820px; padding: 36px 20px 64px;
        background:
          radial-gradient(760px 420px at 10% -10%, rgba(56, 189, 248, 0.15), transparent 65%),
          radial-gradient(620px 380px at 95% 0%, rgba(244, 114, 182, 0.1), transparent 60%),
          var(--bg);
      }
      h1 {
        font-size: clamp(2rem, 5vw, 2.8rem); letter-spacing: -0.03em;
        background: linear-gradient(92deg, #ffffff 10%, #bcc9e6 60%, var(--accent) 100%);
        -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
      }
      .card {
        border-radius: 16px; padding: 22px; border-color: var(--line);
        background: linear-gradient(180deg, rgba(23, 33, 54, 0.92), rgba(12, 18, 32, 0.92));
      }
      .stat { border-radius: 10px; background: #0b1220; border-color: var(--line); }
      .val { color: var(--accent-2); }
      .bar { background: #0b1220; }
      .bar > div { background: linear-gradient(90deg, var(--accent-2), var(--accent)); }
      .delta-up { color: #22f08c; font-weight: 700; }
      .delta-down { color: #ff5d73; font-weight: 700; }
      h1 + div, a { vertical-align: middle; }
    </style>
  </head>
  <body>
    <a href="/">← Back to leaderboard</a>
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:12px">
      {data.avatar_url && <img src={data.avatar_url} alt={username} width="64" height="64" style="border-radius:50%;border:2px solid var(--accent)" />}
      <h1 style="margin:0">{username}</h1>
    </div>

    {(typeof data.score_delta === 'number' || typeof data.rank_delta === 'number') && (
      <p class="movement">
        {typeof data.score_delta === 'number' && data.score_delta !== 0 && (
          <span class={data.score_delta > 0 ? 'delta-up' : 'delta-down'}>{data.score_delta > 0 ? '+' : ''}{data.score_delta.toFixed(1)} pts</span>
        )}
        {typeof data.rank_delta === 'number' && data.rank_delta !== 0 && (
          <span class={data.rank_delta > 0 ? 'delta-up' : 'delta-down'}>{typeof data.score_delta === 'number' && data.score_delta !== 0 ? ' · ' : ''}{data.rank_delta > 0 ? '▲' : '▼'} {Math.abs(data.rank_delta)} ranks</span>
        )}
        {' since yesterday'}
      </p>
    )}
    <img class="badge" src={`/badges/${username}.svg`} alt="badge" width="200" height="60" />
    <div class="card">
      <div class="grid">
        <div class="stat"><div class="label">Activity (12 mo)</div><div class="val">{data.rank_score}</div></div>
        <div class="stat"><div class="label">Global Rank</div><div class="val">#{data.rank}</div></div>
        <div class="stat"><div class="label">Country</div><div class="val" style="font-size:16px">{data.country || '—'}</div></div>
        <div class="stat"><div class="label">Company</div><div class="val" style="font-size:14px">{data.company || '—'}</div></div>
        <div class="stat"><div class="label">Merged PRs</div><div class="val">{data.merged_prs}</div></div>
        <div class="stat"><div class="label">Active days</div><div class="val">{data.active_days || '—'}</div></div>
        {data.commits_1y ? (
          <div class="stat"><div class="label">Commits (1y, not scored)</div><div class="val">{data.commits_1y}</div></div>
        ) : null}
        {data.contributions_1y ? (
          <div class="stat"><div class="label">Contributions (1y, not scored)</div><div class="val">{data.contributions_1y}</div></div>
        ) : null}
        <div class="stat"><div class="label">PR Reviews</div><div class="val">{data.pr_reviews || 0}</div></div>
        <div class="stat"><div class="label">Issue Comments</div><div class="val">{data.issue_comments || 0}</div></div>
        <div class="stat"><div class="label">Releases</div><div class="val">{data.releases || 0}</div></div>
        <div class="stat"><div class="label">Stars Received</div><div class="val">{data.stars_fraud_filtered || 0}</div></div>
        <div class="stat"><div class="label">Forks Received</div><div class="val">{data.forks_fraud_filtered || 0}</div></div>
        <div class="stat"><div class="label">Active Repos</div><div class="val">{data.active_repos_touched || 0}</div></div>
      </div>
    </div>
    {data.bio && <div class="card"><h3>Bio</h3><p style="color:var(--ink);margin:0">{data.bio}</p></div>}
    <p class="note" style="color:var(--muted);font-size:13px">
      An automated count of public GitHub events over a rolling 12-month window — not a statement of fact about a person and not affiliated with GitHub.
      <a href="https://github.com/ErBharatMalhotra/RealGitRank/issues/new?title=Correction%20or%20opt-out%20request&body=GitHub%20username%3A%20%0AWhat%20should%20change%3A%20" target="_blank" rel="noopener noreferrer">Request a correction or removal</a>.
    </p>
    {spark && (
      <div class="card">
        <h3>Score trend · {spark.points} days</h3>
        <svg class="spark" viewBox={`0 0 ${spark.w} ${spark.h}`} preserveAspectRatio="none" role="img" aria-label={`Score trend over ${spark.points} days`}>
          <polygon points={spark.area} fill="rgba(20,184,166,0.15)" />
          <polyline points={spark.line} fill="none" stroke="#14b8a6" stroke-width="2" stroke-linejoin="round" />
        </svg>
        <div class="sparkmeta"><span>{spark.first}</span><span>min {spark.min} · max {spark.max}</span><span>{spark.last}</span></div>
      </div>
    )}
    <div class="card">
      <h3>What the activity is made of · 12 months</h3>
      {activityComponents.map(([name, value]) => {
        const v = Number(value) || 0;
        const share = (v / activityTotal) * 100;
        return (
          <div style="margin:8px 0">
            <div style="display:flex;justify-content:space-between;font-size:13px">
              <span>{name}</span>
              <span>{v.toLocaleString()} ({share.toFixed(1)}%)</span>
            </div>
            <div class="bar"><div style={`width:${share}%`}></div></div>
          </div>
        );
      })}
      <p class="note" style="color:var(--muted);font-size:12px;margin:10px 0 0">The score is the sum of these six public event counts. Nothing is percentile-ranked or weighted.</p>
    </div>
    {Array.isArray(data.counted_merges) && data.counted_merges.length > 0 && (
      <div class="card">
        <h3>Why this rank · counted merges</h3>
        <ul style="margin:0;padding-left:18px;font-size:14px">
          {data.counted_merges.map((m) => (
            <li><a href={`https://github.com/${m.repo}/pulls?q=is%3Apr+is%3Amerged`} rel="nofollow">{m.repo}</a> — {m.prs} merged PR{m.prs === 1 ? '' : 's'}</li>
          ))}
        </ul>
        <p class="note" style="color:var(--muted);font-size:12px;margin:10px 0 0">Merged PRs counted from the public GitHub events feed in the 12-month window.</p>
      </div>
    )}
    <div class="card">
      <h3>README Badge</h3>
      <pre style="background:#0f172a;padding:10px;border-radius:6px;overflow:auto;font-size:12px">[![RealGitRank](https://realgitrank.bharatdn.com/badges/{username}.svg)](https://realgitrank.bharatdn.com/profile/{username})</pre>
    </div>
  </body>
</html>