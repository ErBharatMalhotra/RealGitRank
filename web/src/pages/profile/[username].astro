---
import fs from 'node:fs';
import path from 'node:path';
export function getStaticPaths() {
  const dataDir = path.resolve(process.cwd(), '..', 'data', 'profiles');
  const files = fs.readdirSync(dataDir).filter(f => f.endsWith('.json'));
  return files.map(f => {
    const u = f.replace('.json', '');
    const data = JSON.parse(fs.readFileSync(path.join(dataDir, f), 'utf-8'));
    return { params: { username: u }, props: { data } };
  });
}
const { username } = Astro.params;
const { data } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{username} — RealGitRank</title>
    <meta name="description" content={`RealGitRank profile for ${username}: score ${data.rank_score}, rank #${data.rank}.`} />
    <link rel="canonical" href={`https://realgitrank.bharatdn.com/profile/${username}`} />
    <meta property="og:title" content={`${username} — RealGitRank`} />
    <meta property="og:description" content={`RealGitRank score ${data.rank_score}, rank #${data.rank}`} />
    <meta property="og:image" content={`https://realgitrank.bharatdn.com/badges/${username}.svg`} />
    <meta property="og:type" content="profile" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Person","name":username,"url":`https://realgitrank.bharatdn.com/profile/${username}`})} />
    <style>
      :root { --bg: #0b0f19; --panel: #131a2b; --ink: #e8ecf4; --muted: #8a93a6; --accent: #f59e0b; --accent-2: #14b8a6; --line: #1f2740; }
      body { font-family: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif; max-width: 760px; margin: 0 auto; padding: 28px 20px; background: var(--bg); color: var(--ink); }
      h1 { font-size: 2.4rem; margin: 0 0 4px; letter-spacing: -0.02em; color: var(--ink); }
      h3 { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; margin: 20px 0 8px; }
      .card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 20px; margin: 16px 0; }
      .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .stat { background: var(--bg); padding: 12px; border-radius: 6px; border: 1px solid var(--line); }
      .label { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; }
      .val { font-size: 22px; font-weight: 700; color: var(--accent-2); font-variant-numeric: tabular-nums; }
      .bar { height: 6px; background: var(--line); border-radius: 3px; overflow: hidden; margin-top: 6px; }
      .bar > div { height: 100%; background: var(--accent); }
      a { color: var(--accent); }
      img.badge { margin: 12px 0; border-radius: 6px; }
      pre { background: var(--bg); padding: 10px; border-radius: 6px; overflow: auto; font-size: 12px; border: 1px solid var(--line); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
      img.badge { margin: 12px 0; }
    </style>
  </head>
  <body>
    <a href="/">← Back to leaderboard</a>
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:12px">
      {data.avatar_url && <img src={data.avatar_url} alt={username} width="64" height="64" style="border-radius:50%;border:2px solid var(--accent)" />}
      <h1 style="margin:0">{username}</h1>
    </div>
    <p>{data.is_human_verified ? '✓ Verified Human Engineer' : (data.is_bot_classified ? '🤖 Classified as bot' : 'Developer')}</p>
    <img class="badge" src={`/badges/${username}.svg`} alt="badge" width="200" height="60" />
    <div class="card">
      <div class="grid">
        <div class="stat"><div class="label">Rank Score</div><div class="val">{data.rank_score}</div></div>
        <div class="stat"><div class="label">Global Rank</div><div class="val">#{data.rank}</div></div>
        <div class="stat"><div class="label">Country</div><div class="val" style="font-size:16px">{data.country || '—'}</div></div>
        <div class="stat"><div class="label">Company</div><div class="val" style="font-size:14px">{data.company || '—'}</div></div>
        <div class="stat"><div class="label">Merged PRs</div><div class="val">{data.merged_prs}</div></div>
        <div class="stat"><div class="label">PR Reviews</div><div class="val">{data.pr_reviews || 0}</div></div>
        <div class="stat"><div class="label">Issue Comments</div><div class="val">{data.issue_comments || 0}</div></div>
        <div class="stat"><div class="label">Releases</div><div class="val">{data.releases || 0}</div></div>
        <div class="stat"><div class="label">Stars Received</div><div class="val">{data.stars_fraud_filtered || 0}</div></div>
        <div class="stat"><div class="label">Forks Received</div><div class="val">{data.forks_fraud_filtered || 0}</div></div>
        <div class="stat"><div class="label">Active Repos</div><div class="val">{data.active_repos_touched || 0}</div></div>
        <div class="stat"><div class="label">Bot Penalty</div><div class="val">{data.bot_penalty.toFixed(2)}</div></div>
      </div>
    </div>
    {data.bio && <div class="card"><h3>Bio</h3><p style="color:var(--ink);margin:0">{data.bio}</p></div>}
    <div class="card">
      <h3>Pillar Breakdown</h3>
      {[
        ['Delivery (PRs)', data.s_pr, 0.35],
        ['Code Health', data.s_quality, 0.25],
        ['Adoption (Impact)', data.s_impact, 0.25],
        ['Consistency (Cadence)', data.s_consistency, 0.15],
      ].map(([name, val, w]) => (
        <div style="margin:8px 0">
          <div style="display:flex;justify-content:space-between;font-size:13px"><span>{name} (×{w})</span><span>{val.toFixed(1)}</span></div>
          <div class="bar"><div style={`width:${Math.min(100, val/3)}%`}></div></div>
        </div>
      ))}
    </div>
    <div class="card">
      <h3>README Badge</h3>
      <pre style="background:#0f172a;padding:10px;border-radius:6px;overflow:auto;font-size:12px">[![RealGitRank](https://realgitrank.bharatdn.com/badges/{username}.svg)](https://realgitrank.bharatdn.com/profile/{username})</pre>
    </div>
  </body>
</html>