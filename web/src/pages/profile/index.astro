---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Profile — RealGitRank</title>
    <style>
      :root { --bg: #0b0f19; --panel: #131a2b; --ink: #e8ecf4; --muted: #8a93a6; --accent: #f59e0b; --accent-2: #14b8a6; --line: #1f2740; }
      body { font-family: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif; max-width: 760px; margin: 0 auto; padding: 28px 20px; background: var(--bg); color: var(--ink); }
      h1 { font-size: 2.4rem; margin: 0 0 4px; color: var(--ink); }
      .card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 20px; margin: 16px 0; }
      a { color: var(--accent); }
      .val { font-size: 22px; font-weight: 700; color: var(--accent-2); }
      .label { color: var(--muted); font-size: 11px; text-transform: uppercase; }
      img.badge { margin: 12px 0; border-radius: 6px; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    </style>
  </head>
  <body>
    <a href="/">← Leaderboard</a>
    <div id="content"><p style="color:var(--muted)">Loading profile...</p></div>
    <script>
      const params = new URLSearchParams(location.search);
      const u = params.get('u');
      const el = document.getElementById('content');
      if (!u) { el.innerHTML = '<p>No username provided. <a href="/">Go home</a></p>'; }
      else {
        fetch(`/data/profiles/${u}.json`).then(r => r.ok ? r.json() : null).then(d => {
          if (!d) { el.innerHTML = `<h1>${u}</h1><p>Not ranked yet.</p><img class="badge" src="/badges/default.svg" width="200" height="60" alt="badge" /><p><a href="/">← Leaderboard</a></p>`; return; }
          el.innerHTML = `<h1>${u}</h1><p>${d.is_human_verified ? '✓ Verified Human Engineer' : (d.is_bot_classified ? '🤖 Classified as bot' : 'Developer')}</p>
            <img class="badge" src="/badges/${u}.svg" width="200" height="60" alt="badge" />
            <div class="card"><div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <div><div class="label">Rank Score</div><div class="val">${d.rank_score}</div></div>
              <div><div class="label">Global Rank</div><div class="val">#${d.rank}</div></div>
              <div><div class="label">Country</div><div class="val" style="font-size:16px">${d.country}</div></div>
              <div><div class="label">Language</div><div class="val" style="font-size:16px">${d.primary_language}</div></div>
              <div><div class="label">Merged PRs</div><div class="val">${d.merged_prs}</div></div>
              <div><div class="label">Bot Penalty</div><div class="val">${d.bot_penalty.toFixed(2)}</div></div>
            </div></div>`;
        }).catch(() => { el.innerHTML = `<p>Error loading profile.</p>`; });
      }
    </script>
  </body>
</html>