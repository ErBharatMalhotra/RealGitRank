---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Profile — RealGitRank</title>
    <meta name="robots" content="noindex" />
    <style>
      :root { --bg: #0b0f19; --panel: #131a2b; --ink: #e8ecf4; --muted: #8a93a6; --accent: #f59e0b; --accent-2: #14b8a6; --line: #1f2740; }
      body { font-family: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif; max-width: 760px; margin: 0 auto; padding: 28px 20px; background: var(--bg); color: var(--ink); }
      h1 { font-size: 2.4rem; margin: 0 0 4px; color: var(--ink); }
      h3 { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; margin: 20px 0 8px; }
      .card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 20px; margin: 16px 0; }
      .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .stat { background: var(--bg); padding: 12px; border-radius: 6px; border: 1px solid var(--line); }
      .val { font-size: 22px; font-weight: 700; color: var(--accent-2); font-variant-numeric: tabular-nums; }
      .label { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; }
      a { color: var(--accent); }
      img.badge { margin: 12px 0; border-radius: 6px; }
      pre { background: var(--bg); padding: 10px; border-radius: 6px; overflow: auto; font-size: 12px; border: 1px solid var(--line); }
      .muted { color: var(--muted); }
      .tier { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; padding: 2px 10px; border-radius: 999px; border: 1px solid currentColor; vertical-align: middle; }
      .t-elite { color: #f0abfc; } .t-diamond { color: #60a5fa; } .t-platinum { color: #a78bfa; }
      .t-gold { color: #fbbf24; } .t-silver { color: #cbd5e1; } .t-bronze { color: #d97706; }
      .spark { display: block; width: 100%; height: 64px; margin: 8px 0 4px; }
      .sparkmeta { display: flex; justify-content: space-between; gap: 8px; color: var(--muted); font-size: 11px; }
      .delta-up { color: #34d399; } .delta-down { color: #f87171; }
      .movement { margin: 6px 0 0; font-size: 13px; color: var(--muted); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    </style>
  </head>
  <body>
    <a href="/">← Leaderboard</a>
    <div id="content"><p class="muted">Loading profile...</p></div>
    <script is:inline>
      const params = new URLSearchParams(location.search);
      const u = params.get('u');
      const hintRank = parseInt(params.get('r') || '', 10);
      const el = document.getElementById('content');
      let chunkSize = 250; // overridden by /data/chunks/index.json

      const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

      async function fetchJSON(url) {
        try {
          const r = await fetch(url);
          return r.ok ? await r.json() : null;
        } catch (e) {
          return null;
        }
      }

      // Everyone outside the pre-built top-1,000 profiles lives in the leaderboard
      // chunks. The search bucket gives the exact page pointer (listed accounts
      // have no rank but do have a page), so a profile never scans the board.
      async function locate(username) {
        const first = String(username || '').slice(0, 1).toLowerCase();
        const bucket = /[a-z0-9]/.test(first) ? first : 'other';
        const rows = await fetchJSON(`/data/search/${bucket}.json`);
        if (!Array.isArray(rows)) return null;
        const want = username.toLowerCase();
        const hit = rows.find((r) => String(r[0]).toLowerCase() === want);
        if (!hit) return null;
        return {
          rank: Number.isFinite(hit[1]) ? hit[1] : null,
          page: Number.isFinite(hit[4]) ? hit[4] : null,
        };
      }

      async function findInChunks(username) {
        const want = username.toLowerCase();
        const idx = await fetchJSON('/data/chunks/index.json');
        chunkSize = idx && idx.chunk_size ? idx.chunk_size : chunkSize;
        const totalPages = idx && idx.pages ? idx.pages : 0;
        const located = await locate(username);
        let center = located && located.page ? located.page : null;
        const rank = located && located.rank ? located.rank : (Number.isFinite(hintRank) && hintRank > 0 ? hintRank : null);
        if (!center && rank) center = Math.ceil(rank / chunkSize);
        // Check the exact page first, then at most two pages either side. Scanning
        // all 3,000+ pages made an unknown name look like a broken profile.
        const pages = [];
        if (center) {
          pages.push(center);
          for (let d = 1; d <= 2; d++) {
            if (center - d >= 1) pages.push(center - d);
            if (!totalPages || center + d <= totalPages) pages.push(center + d);
          }
        }
        for (const p of pages.slice(0, 5)) {
          const data = await fetchJSON(`/data/chunks/page_${p}.json`);
          if (!Array.isArray(data)) continue;
          const hit = data.find((x) => (x.username || '').toLowerCase() === want);
          if (hit) return hit;
        }
        return null;
      }

      function moveText(d) {
        const bits = [];
        if (typeof d.score_delta === 'number' && d.score_delta !== 0) {
          bits.push(`<span class="${d.score_delta > 0 ? 'delta-up' : 'delta-down'}">${d.score_delta > 0 ? '+' : ''}${d.score_delta.toFixed(1)} pts</span>`);
        }
        if (typeof d.rank_delta === 'number' && d.rank_delta !== 0) {
          const up = d.rank_delta > 0;
          bits.push(`<span class="${up ? 'delta-up' : 'delta-down'}">${up ? '▲' : '▼'} ${Math.abs(d.rank_delta)} ranks</span>`);
        }
        return bits.length ? `<p class="movement">${bits.join(' · ')} since yesterday</p>` : '';
      }

      function listedOnlyNote(d) {
        if (!d.listed_only) return '';
        return `<p class="muted" style="margin:0 0 8px;font-size:13px">Listed · no public pushes or merged pull requests were observed in this 30-day window, so no score, rank or tier is claimed.</p>`;
      }

      function tierBadge(d) {
        if (!d.tier) return '';
        const pct = typeof d.percentile === 'number' ? `Ahead of ${d.percentile}% of ranked developers` : '';
        return `<span class="tier t-${String(d.tier).toLowerCase()}" title="${esc(pct)}">${esc(d.tier)}</span>`;
      }

      // Score sparkline from the per-profile daily history the pipeline keeps (top 1,000).
      function sparkBlock(d) {
        const pts = (d.history || []).filter((p) => p && typeof p.s === 'number');
        if (pts.length < 2) return '';
        const w = 320, h = 64, pad = 8;
        const min = Math.min(...pts.map((p) => p.s)), max = Math.max(...pts.map((p) => p.s));
        const x = (i) => pad + (i * (w - 2 * pad)) / (pts.length - 1);
        const y = (v) => h - pad - (max === min ? 0.5 : ((v - min) / (max - min))) * (h - 2 * pad);
        const line = pts.map((p, i) => `${x(i).toFixed(1)},${y(p.s).toFixed(1)}`).join(' ');
        const area = `${x(0).toFixed(1)},${(h - pad).toFixed(1)} ${line} ${x(pts.length - 1).toFixed(1)},${(h - pad).toFixed(1)}`;
        return `<div class="card"><h3>Score trend · ${pts.length} days</h3>
          <svg class="spark" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" role="img" aria-label="Score trend over ${pts.length} days">
            <polygon points="${area}" fill="rgba(20,184,166,0.15)" />
            <polyline points="${line}" fill="none" stroke="#14b8a6" stroke-width="2" stroke-linejoin="round" />
          </svg>
          <div class="sparkmeta"><span>${esc(pts[0].d)}</span><span>min ${min} · max ${max}</span><span>${esc(pts[pts.length - 1].d)}</span></div>
        </div>`;
      }

      // Lifetime context from GitHub enrichment. Never part of the score: the
      // ranking only sees public events inside the 30-day window.
      function portfolioBlock(d) {
        const stats = [];
        if (d.stars_total) stats.push(['Stars on owned repos', d.stars_total]);
        if (d.commits_1y) stats.push(['Commits last year (GitHub)', d.commits_1y]);
        if (d.repos_total) stats.push(['Public repos', d.repos_total]);
        if (d.followers) stats.push(['Followers', d.followers]);
        if (!stats.length) return '';
        return `<div class="card"><h3>GitHub portfolio · lifetime context, not scored</h3>
          <div class="grid">${stats.map(([label, value]) => `<div class="stat"><div class="label">${esc(label)}</div><div class="val">${Number(value).toLocaleString()}</div></div>`).join('')}</div>
          <p class="muted" style="margin:10px 0 0;font-size:12px">Reported by the GitHub API. The Rank Score above only uses events published inside the 30-day window, so work pushed by a bot or kept private does not appear in it.</p></div>`;
      }

      // One badge rule for everyone: the badge service renders the ranked, listed
      // and not-found states from the same snapshot data as this page.
      const BADGE_SERVICE = 'https://realgitrank-badges-ganx3c.freebuff.site';
      function badgeFor(username) {
        return `${BADGE_SERVICE}/badges/${encodeURIComponent(username)}.svg`;
      }

      function metricsBlock(d) {
        const facts = `<div class="grid">
              <div class="stat"><div class="label">Country</div><div class="val" style="font-size:16px">${esc(d.country || '—')}</div></div>
              <div class="stat"><div class="label">Language</div><div class="val" style="font-size:16px">${esc(d.primary_language || '—')}</div></div>
              <div class="stat"><div class="label">Merged PRs</div><div class="val">${esc(d.merged_prs)}</div></div>
              ${d.ci_pushes ? `<div class="stat"><div class="label">CI-attributed pushes</div><div class="val">${esc(d.ci_pushes)}</div></div>` : ''}
            </div>`;
        if (d.listed_only) {
          return `<div class="card">
            <p style="margin:0 0 4px;font-weight:600">Listed · not scored in this 30-day window</p>
            <p class="muted" style="margin:0 0 14px;font-size:13px">No public push or merged pull request was observed for this account. A rank, score or tier is intentionally not shown.</p>
            ${facts}
          </div>`;
        }
        return `<div class="card"><div class="grid">
              <div class="stat"><div class="label">Rank Score</div><div class="val">${esc(d.rank_score)}</div></div>
              <div class="stat"><div class="label">Global Rank</div><div class="val">#${esc(d.rank)}</div></div>
              ${facts}
            </div></div>`;
      }

      function notRanked(username) {
        el.innerHTML = `<h1>${esc(username)}</h1>
          <p>Not in this snapshot — this GitHub username was not observed in the current 30-day window.</p>
          <img class="badge" src="/badges/default.svg" width="200" height="60" alt="badge" />
          <p class="muted">Check the spelling, or <a href="/">search the leaderboard</a>. Contribute on GitHub and the next daily run can pick the account up.</p>`;
      }

      function renderFromChunk(d) {
        el.innerHTML = `<h1>${esc(d.username)}</h1>
          <p>${tierBadge(d)}</p>
          ${listedOnlyNote(d)}
          ${moveText(d)}
          <img class="badge" src="${badgeFor(d.username)}" width="200" height="60" alt="badge" onerror="this.src='/badges/default.svg'" />
          ${metricsBlock(d)}
          ${portfolioBlock(d)}
          ${d.bio ? `<div class="card"><h3>Bio</h3><p style="margin:0">${esc(d.bio)}</p></div>` : ''}
          ${sparkBlock(d)}
          <div class="card">
            <h3>README Badge</h3>
            <pre>[![RealGitRank](${badgeFor(d.username)})](https://realgitrank.bharatdn.com/profile/?u=${encodeURIComponent(d.username)})</pre>
          </div>
          <p class="muted" style="font-size:13px">${d.listed_only ? 'Listed in today’s snapshot without a rank claim.' : 'Ranked in today’s snapshot.'} Detailed pillar breakdowns are generated for the top 1,000 developers.</p>
          <p class="muted" style="font-size:12px">An automated estimate from public GitHub events, not a statement of fact about a person. <a href="https://github.com/ErBharatMalhotra/RealGitRank/issues/new?title=Correction%20or%20opt-out%20request&body=GitHub%20username%3A%20%0AWhat%20should%20change%3A%20" target="_blank" rel="noopener noreferrer">Request a correction or removal</a>.</p>`;
      }

      function renderFromProfile(d, username) {
        el.innerHTML = `<h1>${esc(username)}</h1><p>${tierBadge(d)}</p>
          ${listedOnlyNote(d)}
          ${moveText(d)}
          <img class="badge" src="${badgeFor(username)}" width="200" height="60" alt="badge" onerror="this.src='/badges/default.svg'" />
          ${metricsBlock(d)}
          ${portfolioBlock(d)}
          ${sparkBlock(d)}
          <div class="card"><h3>README Badge</h3>
            <pre>[![RealGitRank](${badgeFor(username)})](https://realgitrank.bharatdn.com/profile/?u=${encodeURIComponent(username)})</pre>
          </div>
          <p class="muted" style="font-size:12px">An automated estimate from public GitHub events, not a statement of fact about a person. <a href="https://github.com/ErBharatMalhotra/RealGitRank/issues/new?title=Correction%20or%20opt-out%20request&body=GitHub%20username%3A%20%0AWhat%20should%20change%3A%20" target="_blank" rel="noopener noreferrer">Request a correction or removal</a>.</p>`;
      }

      (async () => {
        if (!u) { el.innerHTML = '<p>No username provided. <a href="/">Go home</a></p>'; return; }
        // Fresh per-user profile JSON (top 1,000 only); chunks cover everyone else.
        const profile = await fetchJSON(`/data/profiles/${encodeURIComponent(u)}.json`);
        if (profile) { renderFromProfile(profile, u); return; }
        const chunkUser = await findInChunks(u);
        if (chunkUser) { renderFromChunk(chunkUser); return; }
        notRanked(u);
      })();
    </script>
  </body>
</html>
